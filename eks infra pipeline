pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/ruchikaborkar01-glitch/new-repo--1.git'
            }
        }

        stage('Init') {
            steps {
                sh '''
                    terraform init
                '''
            }
        }

        stage('Plan') {
            steps {
                sh '''
                    terraform plan
                '''
            }
        }

        stage('Apply') {
            steps {
                sh '''
                    terraform apply -auto-approve
                '''
            }
        }
    }
}
